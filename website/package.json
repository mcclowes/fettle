{
  "name": "fettle-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others --names site,docs \"next dev\" \"npm run docs:dev\"",
    "site:dev": "next dev",
    "build": "npm run docs:build && next build",
    "start": "next start",
    "check": "npm run docs:check && npm run typecheck",
    "test": "node --test scripts/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "docs:dev": "docusaurus start --port 3001 --no-open",
    "docs:check": "node scripts/check-docs.mjs",
    "docs:build": "docusaurus build --out-dir public/docs",
    "docs:serve": "docusaurus serve --port 3001 --no-open"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.6.3",
    "@clerk/themes": "^2.4.57",
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "^3.0.0",
    "next": "^16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^10.0.6",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "@docusaurus/core": {
      "tinypool": "2.1.2"
    },
    "@docusaurus/bundler": {
      "postcss-selector-parser": "7.1.6"
    },
    "copy-webpack-plugin": {
      "serialize-javascript": "7.0.5"
    },
    "css-minimizer-webpack-plugin": {
      "serialize-javascript": "7.0.5"
    },
    "sockjs": {
      "uuid": "11.1.1"
    }
  }
}
